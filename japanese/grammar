<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Japanese grammar practice</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@500&display=swap">
<style>
:root {
  --paper: #f3efe6; --ink: #1d2433; --accent: #a3342b; --panel: #e6e0d2; --line: #c9c0ad;
  --field: #fbf9f3; --muted: #6c6a63; --size: 30px;
  color-scheme: light; box-sizing: border-box;
  padding-top: env(safe-area-inset-top, 0px); padding-bottom: env(safe-area-inset-bottom, 0px);
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --paper: #151a24; --ink: #ece6d6; --accent: #e8806f; --panel: #1e2432; --line: #38405a;
    --field: #11151e; --muted: #9a98a0; color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --paper: #151a24; --ink: #ece6d6; --accent: #e8806f; --panel: #1e2432; --line: #38405a;
  --field: #11151e; --muted: #9a98a0; color-scheme: dark;
}
*, *::before, *::after { box-sizing: inherit; }
html, body { height: 100%; margin: 0; }
@supports (height: 100dvh) { body { height: 100dvh; } }
body {
  background: var(--paper); color: var(--ink);
  font-family: "Shippori Mincho", "Hiragino Mincho ProN", "Yu Mincho", "Noto Serif JP", serif;
  display: grid; grid-template-rows: minmax(0, 1fr) auto; overflow: hidden;
}
#stage { display: flex; flex-direction: column; align-items: center; padding: 20px; overflow: auto; min-height: 0; }
#card { margin: auto; width: 100%; max-width: 36em; display: grid; gap: 14px; text-align: center; }
#q { margin: 0; color: var(--muted); font: 15px system-ui, -apple-system, "Segoe UI", sans-serif; }
#sent { margin: 0; font-size: var(--size); line-height: 2.4; font-weight: 500; overflow-wrap: anywhere; }
#sent rt { font-size: 0.5em; }
body.nofuri #sent rt { display: none; }
body.nofuri #sent { line-height: 1.9; }
#en { margin: 0; color: var(--muted); font: 16px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }
#en[hidden], #fb[hidden] { display: none; }
.blank { display: inline-block; min-width: 1.6em; border-bottom: 2px solid var(--accent); line-height: 1.2; }
.ok { background: rgba(60,170,100,.3); border-radius: 4px; }
.bad { background: rgba(220,80,70,.3); border-radius: 4px; }
.tk { cursor: pointer; border-radius: 4px; padding: 0 1px; }
.tk:hover { background: rgba(255,190,0,.25); }
#opts { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
#opts button { min-width: 5.5em; font-size: 20px; padding: 10px 16px; font-family: inherit; }
#opts button.ok, #opts button.bad { color: var(--ink); }
select.bs { font: 20px inherit; font-family: inherit; color: var(--ink); background: var(--field); border: 1px solid var(--line); border-radius: 6px; padding: 2px 4px; }
select.bs.ok { background: rgba(60,170,100,.3); } select.bs.bad { background: rgba(220,80,70,.3); }
#fb { text-align: left; padding: 10px 14px; border: 1px solid var(--line); border-radius: 8px; background: var(--panel); font: 15px/1.6 system-ui, -apple-system, "Segoe UI", sans-serif; }
#fb p { margin: 2px 0; }
#panel {
  background: var(--panel); border-top: 1px solid var(--line); padding: 10px 16px 12px;
  display: flex; flex-wrap: wrap; gap: 8px; align-items: center; justify-content: center;
  font: 14px system-ui, -apple-system, "Segoe UI", sans-serif;
}
button, select { font: inherit; color: var(--ink); background: var(--field); border: 1px solid var(--line); border-radius: 6px; padding: 7px 12px; cursor: pointer; touch-action: manipulation; }
button.primary { background: var(--ink); color: var(--paper); border-color: var(--ink); font-weight: 600; padding: 7px 20px; }
button[aria-pressed="true"] { background: var(--ink); color: var(--paper); border-color: var(--ink); }
button:disabled { opacity: .5; cursor: default; }
button:focus-visible, select:focus-visible, input:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
label.size { display: flex; gap: 6px; align-items: center; color: var(--muted); }
#score { color: var(--muted); min-width: 7em; text-align: center; }
input[type="range"] { -webkit-appearance: none; appearance: none; width: 100px; height: 24px; background: transparent; margin: 0; padding: 0; cursor: pointer; }
input[type="range"]::-webkit-slider-runnable-track { height: 4px; border-radius: 2px; background: var(--line); }
input[type="range"]::-moz-range-track { height: 4px; border-radius: 2px; background: var(--line); }
input[type="range"]::-webkit-slider-thumb { -webkit-appearance: none; width: 18px; height: 18px; margin-top: -7px; border-radius: 50%; background: var(--ink); border: 2px solid var(--panel); box-shadow: 0 0 0 1px var(--ink); }
input[type="range"]::-moz-range-thumb { width: 14px; height: 14px; border-radius: 50%; background: var(--ink); border: 2px solid var(--panel); }
@media (pointer: coarse) {
  button, select { min-height: 42px; } select, select.bs { font-size: 16px; }
  select.bs { font-size: 18px; min-height: 40px; }
  input[type="range"] { height: 36px; }
  input[type="range"]::-webkit-slider-thumb { width: 26px; height: 26px; margin-top: -11px; }
}
@media (max-width: 600px) { #stage { padding: 12px; } #panel { gap: 6px; padding: 8px 10px; } #opts button { flex: 1 1 40%; } }

@media (max-width: 700px) {
  html, body { height: auto; }
  body { display: flex; flex-direction: column; min-height: 100vh; overflow: auto; }
  #panel { order: -1; border-top: 0; border-bottom: 1px solid var(--line); }
  #stage { flex: 1 0 auto; overflow: visible; }
  .emb #panel { padding-top: 56px; }
}
</style>
</head>
<body>
<main id="stage">
  <div id="card">
    <p id="q"></p>
    <p id="sent" lang="ja"></p>
    <p id="en" hidden></p>
    <div id="opts"></div>
    <div id="fb" hidden></div>
  </div>
</main>

<section id="panel">
  <select id="mode" aria-label="Exercise type">
    <option value="particle">Choose the particle</option>
    <option value="all">Fill in missing particles</option>
    <option value="blank">Fill in the ending</option>
    <option value="error">Find the error</option>
  </select>
  <button id="furi" aria-pressed="true">Furigana</button>
  <button id="hint" aria-pressed="true">English hint</button>
  <button class="primary" id="next">Next</button>
  <span id="score" aria-live="polite">0 / 0</span>
  <label class="size">Size <input type="range" id="size" min="20" max="56" value="30"></label>
  <button id="theme">Light / dark</button>
</section>

<script>
(function () {
  var $ = function (i) { return document.getElementById(i); };
  var rnd = function (a) { return a[Math.floor(Math.random() * a.length)]; };
  var shuf = function (a) { return a.slice().sort(function () { return Math.random() - 0.5; }); };
  var esc = function (t) { return String(t).replace(/[&<>]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]; }); };
  var ruby = function (t) { return esc(t).replace(/([\u4e00-\u9fff々]+)\{([^}]+)\}/g, '<ruby>$1<rt>$2</rt></ruby>'); };

  var W = function (t) { return { k: 'w', t: t }; };
  var P = function (t, role) { return { k: 'p', t: t, c: t, role: role, fixed: role === 'topic' }; };
  var V = function (c, o, why, werr) { return { k: 'v', t: c, c: c, o: o, why: why, werr: werr || null }; };

  var WHY = {
    topic: 'は marks the topic: who or what the sentence is about.',
    act: 'で marks the place where an action happens.',
    obj: 'を marks the object of an action verb.',
    exist: 'に marks the place where something exists (with あります / います).',
    esub: 'が marks the thing or person that exists.',
    dir: 'へ marks the direction you are going toward.',
    'with': 'と means “with” (a companion).',
    time: 'に marks a specific clock time.',
    from: 'から marks a starting point.',
    until: 'まで marks an ending point.',
    poss: 'の links two nouns, like possession (my book).'
  };
  var WR = { topic: ['を', 'に', 'で'], act: ['を', 'が', 'と'], obj: ['に', 'で', 'へ'], exist: ['を', 'と', 'から'], esub: ['を', 'で', 'へ'],
             dir: ['で', 'が'], 'with': ['を', 'が'], time: ['を', 'が', 'で'], from: ['を', 'が', 'に'], until: ['を', 'が'], poss: ['を', 'に', 'で'] };
  var CONF = { 'を': ['が', 'に', 'で', 'へ'], 'で': ['に', 'を', 'へ', 'と'], 'に': ['で', 'へ', 'を', 'から'], 'が': ['を', 'は', 'も', 'に'],
               'へ': ['に', 'で', 'を', 'と'], 'と': ['や', 'も', 'に', 'で'], 'の': ['は', 'が', 'を', 'に'], 'から': ['まで', 'に', 'で', 'を'],
               'まで': ['から', 'に', 'で', 'を'] };
  var ALLP = ['は', 'が', 'を', 'に', 'で', 'へ', 'と', 'も', 'の', 'から', 'まで'];
  var VO = ['ます', 'ました', 'です', 'でした'];
  var WP = 'A past time word (like 昨日) means the verb ends in ました.';
  var WN = 'Habits and present actions use the ます form.';

  var WHO = [['私{わたし}', 'I', 0, 'my'], ['友達{ともだち}', 'my friend', 1, 'my friend’s'], ['母{はは}', 'my mother', 1, 'my mother’s'],
             ['兄{あに}', 'my brother', 1, 'my brother’s'], ['先生{せんせい}', 'the teacher', 1, 'the teacher’s'], ['田中{たなか}さん', 'Mr. Tanaka', 1, 'Mr. Tanaka’s']];
  var TP = [['毎朝{まいあさ}', 'Every morning'], ['毎日{まいにち}', 'Every day'], ['週末{しゅうまつ}', 'On weekends']];
  var TS = [['昨日{きのう}', 'Yesterday'], ['先週{せんしゅう}', 'Last week'], ['昨夜{さくや}', 'Last night']];
  var TF = [['来週{らいしゅう}', 'Next week'], ['来月{らいげつ}', 'Next month'], ['来年{らいねん}', 'Next year']];
  var ACTS = [['本{ほん}', '読{よ}み', 'read a book', 'reads a book', 'read a book'], ['お茶{ちゃ}', '飲{の}み', 'drink tea', 'drinks tea', 'drank tea'],
    ['音楽{おんがく}', '聞{き}き', 'listen to music', 'listens to music', 'listened to music'], ['写真{しゃしん}', '撮{と}り', 'take photos', 'takes photos', 'took photos'],
    ['手紙{てがみ}', '書{か}き', 'write a letter', 'writes a letter', 'wrote a letter'], ['ご飯{はん}', '食{た}べ', 'eat a meal', 'eats a meal', 'ate a meal'],
    ['映画{えいが}', '見{み}', 'watch a movie', 'watches a movie', 'watched a movie'], ['', '勉強{べんきょう}し', 'study', 'studies', 'studied'],
    ['', '散歩{さんぽ}し', 'take a walk', 'takes a walk', 'took a walk']];
  var PLACES = [['公園{こうえん}', 'the park'], ['図書館{としょかん}', 'the library'], ['喫茶店{きっさてん}', 'a café'], ['学校{がっこう}', 'school'], ['家{いえ}', 'home']];
  var DEST = [['京都{きょうと}', 'Kyoto'], ['大阪{おおさか}', 'Osaka'], ['奈良{なら}', 'Nara'], ['北海道{ほっかいどう}', 'Hokkaido'], ['沖縄{おきなわ}', 'Okinawa'], ['東京{とうきょう}', 'Tokyo']];
  var COMP = [['友達{ともだち}', 'a friend'], ['母{はは}', 'my mother'], ['兄{あに}', 'my brother'], ['先生{せんせい}', 'the teacher']];
  var SPOT = [['公園{こうえん}', 'in the park'], ['庭{にわ}', 'in the garden'], ['部屋{へや}', 'in the room'], ['学校{がっこう}', 'at school']];
  var THG = [['木{き}', 'a tree', 0], ['池{いけ}', 'a pond', 0], ['ベンチ', 'a bench', 0], ['犬{いぬ}', 'a dog', 1], ['猫{ねこ}', 'a cat', 1], ['先生{せんせい}', 'a teacher', 1]];
  var DESC = [['本{ほん}', 'book', [['面白{おもしろ}', 'interesting'], ['古{ふる}', 'old'], ['新{あたら}し', 'new']]],
              ['部屋{へや}', 'room', [['大{おお}き', 'big'], ['小{ちい}さ', 'small'], ['明{あか}る', 'bright']]],
              ['料理{りょうり}', 'dish', [['美味{おい}し', 'delicious'], ['辛{から}', 'spicy']]],
              ['映画{えいが}', 'movie', [['面白{おもしろ}', 'interesting'], ['長{なが}', 'long']]]];
  var HRS = [['六時{ろくじ}', '6:00'], ['七時{しちじ}', '7:00'], ['八時{はちじ}', '8:00'], ['九時{くじ}', '9:00'], ['十時{じゅうじ}', '10:00']];
  var EVS = [['起{お}き', 'wake up', 'wakes up', 'woke up'], ['寝{ね}', 'go to bed', 'goes to bed', 'went to bed'], ['帰{かえ}り', 'go home', 'goes home', 'went home']];
  var WK = [['働{はたら}き', 'work', 'works', 'worked'], ['勉強{べんきょう}し', 'study', 'studies', 'studied']];
  var ST = [['八時{はちじ}', '8:00'], ['九時{くじ}', '9:00'], ['十時{じゅうじ}', '10:00']];
  var UN = [['四時{よじ}', '4:00'], ['五時{ごじ}', '5:00'], ['六時{ろくじ}', '6:00']];
  var DM = [['これ', 'This'], ['それ', 'That'], ['あれ', 'That one over there']];
  var NOUN = [['本{ほん}', 'book'], ['傘{かさ}', 'umbrella'], ['鞄{かばん}', 'bag'], ['写真{しゃしん}', 'photo']];
  var tn = function () { return Math.random() < 0.45; };

  function f1() {
    var pa = tn(), tm = rnd(pa ? TS : TP), w = rnd(WHO), a = rnd(ACTS), pl = rnd(PLACES);
    var tk = [W(tm[0]), W('、'), W(w[0]), P('は', 'topic'), W(pl[0]), P('で', 'act')];
    if (a[0]) tk.push(W(a[0]), P('を', 'obj'));
    tk.push(W(a[1]), V(pa ? 'ました' : 'ます', VO, pa ? WP : WN, pa ? 'ます' : null), W('。'));
    return { tk: tk, en: tm[1] + ', ' + w[1] + ' ' + (pa ? a[4] : (w[2] ? a[3] : a[2])) + ' at ' + pl[1] + '.' };
  }
  function f2() {
    var pa = tn(), tm = rnd(pa ? TS : TF), w = rnd(WHO), c = rnd(COMP), d = rnd(DEST);
    return { tk: [W(tm[0]), W('、'), W(w[0]), P('は', 'topic'), W(c[0]), P('と', 'with'), W(d[0]), P('へ', 'dir'), W('行{い}き'),
                  V(pa ? 'ました' : 'ます', VO, pa ? WP : 'Plans for later use the ます form.', pa ? 'ます' : null), W('。')],
             en: tm[1] + ', ' + w[1] + ' ' + (pa ? 'went' : 'will go') + ' to ' + d[1] + ' with ' + c[1] + '.' };
  }
  function f3() {
    var pa = tn(), pl = rnd(SPOT), it = rnd(THG), an = it[2], suf = pa ? 'ました' : 'ます';
    var tk = [];
    if (pa) tk.push(W('昨日{きのう}'), W('、'));
    tk.push(W(pl[0]), P('に', 'exist'), W(it[0]), P('が', 'esub'),
      V((an ? 'い' : 'あり') + suf, ['あります', 'います', 'ありました', 'いました'],
        (an ? 'People and animals use います.' : 'Things that do not move use あります.') + (pa ? ' Past tense ends in ました.' : ''), (an ? 'あり' : 'い') + suf), W('。'));
    return { tk: tk, en: (pa ? 'Yesterday, there was ' : 'There is ') + it[1] + ' ' + pl[1] + '.' };
  }
  function f4() {
    var pa = tn(), th = rnd(DESC), ad = rnd(th[2]), tm = pa ? ['昨日{きのう}', 'Yesterday'] : ['今日{きょう}', 'Today'];
    return { tk: [W(tm[0]), W('、'), W('この'), W(th[0]), P('は', 'topic'), W(ad[0]),
                  V(pa ? 'かったです' : 'いです', ['いです', 'かったです', 'でした', 'ます'],
                    pa ? 'Past with an い-adjective: drop い and add かったです.' : 'Present with an い-adjective: keep い and add です.', pa ? 'いです' : null), W('。')],
             en: tm[1] + ', this ' + th[1] + ' ' + (pa ? 'was ' : 'is ') + ad[1] + '.' };
  }
  function f5() {
    var pa = tn(), tm = pa ? rnd(TS) : ['毎日{まいにち}', 'Every day'], w = rnd(WHO), hr = rnd(HRS), ev = rnd(EVS);
    return { tk: [W(tm[0]), W('、'), W(w[0]), P('は', 'topic'), W(hr[0]), P('に', 'time'), W(ev[0]), V(pa ? 'ました' : 'ます', VO, pa ? WP : WN, pa ? 'ます' : null), W('。')],
             en: tm[1] + ', ' + w[1] + ' ' + (pa ? ev[3] : (w[2] ? ev[2] : ev[1])) + ' at ' + hr[1] + '.' };
  }
  function f6() {
    var pa = tn(), tm = pa ? rnd(TS) : ['毎日{まいにち}', 'Every day'], w = rnd(WHO), a = rnd(WK), s = rnd(ST), e = rnd(UN);
    return { tk: [W(tm[0]), W('、'), W(w[0]), P('は', 'topic'), W(s[0]), P('から', 'from'), W(e[0]), P('まで', 'until'), W(a[0]),
                  V(pa ? 'ました' : 'ます', VO, pa ? WP : WN, pa ? 'ます' : null), W('。')],
             en: tm[1] + ', ' + w[1] + ' ' + (pa ? a[3] : (w[2] ? a[2] : a[1])) + ' from ' + s[1] + ' to ' + e[1] + '.' };
  }
  function f7() {
    var w = rnd(WHO), n = rnd(NOUN), d = rnd(DM);
    return { tk: [W(d[0]), P('は', 'topic'), W(w[0]), P('の', 'poss'), W(n[0]), W('です'), W('。')], en: d[1] + ' is ' + w[3] + ' ' + n[1] + '.' };
  }
  var FR = [f1, f1, f2, f3, f4, f5, f6, f7];

  var cur, mode = 'particle', done = false, score = { c: 0, t: 0, s: 0 }, err = null;
  var idxs = function (fn) { var r = []; cur.tk.forEach(function (t, i) { if (fn(t)) r.push(i); }); return r; };
  var isPart = function (t) { return t.k === 'p' && !t.fixed; };
  var isEnd = function (t) { return t.k === 'v' && t.o; };

  function build(over) {
    return cur.tk.map(function (t, i) { return over[i] !== undefined ? over[i] : (t.k === 'w' ? ruby(t.t) : esc(t.t)); }).join('');
  }
  function show(msg) { var fb = $('fb'); fb.innerHTML = msg; fb.hidden = false; $('en').textContent = cur.en; $('en').hidden = false; }
  function record(ok) {
    done = true; score.t++;
    if (ok) { score.c++; score.s++; } else score.s = 0;
    $('score').textContent = score.c + ' / ' + score.t + (score.s > 1 ? ' · streak ' + score.s : '');
  }
  function mk(tag, cls, txt) { var e = document.createElement(tag); if (cls) e.className = cls; if (txt !== undefined) e.textContent = txt; return e; }

  function next() {
    var ok = false, tries = 0;
    while (!ok && tries++ < 20) {
      cur = rnd(FR)();
      ok = mode === 'error' || (mode === 'blank' ? idxs(isEnd).length : idxs(isPart).length);
    }
    render();
  }
  function render() {
    var q = $('q'), sent = $('sent'), opts = $('opts');
    done = false; err = null; opts.innerHTML = ''; $('fb').hidden = true; sent.onclick = null;
    $('en').textContent = cur.en; $('en').hidden = $('hint').getAttribute('aria-pressed') !== 'true';
    var over = {};
    if (mode === 'particle' || mode === 'blank') {
      var bi = rnd(idxs(mode === 'blank' ? isEnd : isPart)), t = cur.tk[bi];
      over[bi] = '<span class="blank" id="bl">＿＿</span>';
      q.textContent = mode === 'blank' ? 'Choose the correct ending.' : 'Choose the missing particle.';
      sent.innerHTML = build(over);
      var choices = mode === 'blank' ? shuf(t.o) : shuf([t.c].concat(shuf(CONF[t.c]).slice(0, 3)));
      choices.forEach(function (c, n) {
        var b = mk('button', '', c); b.title = 'Key ' + (n + 1);
        b.addEventListener('click', function () {
          if (done) return;
          var ok = c === t.c;
          record(ok);
          b.classList.add(ok ? 'ok' : 'bad');
          if (!ok) Array.prototype.forEach.call(opts.children, function (x) { if (x.textContent === t.c) x.classList.add('ok'); });
          $('bl').textContent = t.c; $('bl').className = 'blank ' + (ok ? 'ok' : 'bad');
          show('<p><b>' + (ok ? 'Correct!' : 'Not quite. The answer is ' + esc(t.c) + '.') + '</b></p><p>' + esc(mode === 'blank' ? t.why : WHY[t.role]) + '</p>');
        });
        opts.appendChild(b);
      });
    } else if (mode === 'all') {
      q.textContent = 'Fill in every missing particle, then check.';
      idxs(isPart).forEach(function (i) {
        over[i] = '<select class="bs" data-i="' + i + '" aria-label="Particle"><option value="">？</option>' +
          ALLP.map(function (p) { return '<option>' + p + '</option>'; }).join('') + '</select>';
      });
      sent.innerHTML = build(over);
      var chk = mk('button', 'primary', 'Check');
      chk.addEventListener('click', function () {
        if (done) return;
        var wrong = [], all = sent.querySelectorAll('select.bs');
        Array.prototype.forEach.call(all, function (sel) {
          var t = cur.tk[+sel.getAttribute('data-i')], ok = sel.value === t.c;
          sel.classList.add(ok ? 'ok' : 'bad');
          if (!ok) { wrong.push(t); sel.title = 'Answer: ' + t.c; }
        });
        record(!wrong.length);
        show(wrong.length ? '<p><b>' + (all.length - wrong.length) + ' of ' + all.length + ' correct.</b></p>' +
          wrong.map(function (t) { return '<p>' + esc(t.c) + ' — ' + esc(WHY[t.role]) + '</p>'; }).join('') : '<p><b>All correct!</b></p>');
        Array.prototype.forEach.call(all, function (sel) { sel.value = cur.tk[+sel.getAttribute('data-i')].c; });
      });
      opts.appendChild(chk);
    } else {
      var cands = [];
      cur.tk.forEach(function (t, i) {
        if (t.k === 'p') cands.push({ i: i, w: rnd(WR[t.role]), why: WHY[t.role] });
        if (t.k === 'v' && t.werr) cands.push({ i: i, w: t.werr, why: t.why });
      });
      err = cands.length && Math.random() < 0.8 ? rnd(cands) : null;
      q.textContent = 'Tap the part that is wrong, or say there is no mistake.';
      cur.tk.forEach(function (t, i) {
        var shown = err && err.i === i ? err.w : t.t;
        over[i] = (t.k === 'w' && /^[、。]$/.test(t.t)) ? esc(t.t) : '<span class="tk" data-i="' + i + '">' + (t.k === 'w' ? ruby(shown) : esc(shown)) + '</span>';
      });
      sent.innerHTML = build(over);
      var finish = function (ok, clicked) {
        if (done) return;
        record(ok);
        if (err) {
          var el = sent.querySelector('[data-i="' + err.i + '"]');
          el.className = 'tk ok'; el.textContent = cur.tk[err.i].t;
          if (!ok && clicked) clicked.className = 'tk bad';
          show('<p><b>' + (ok ? 'Correct!' : 'Not quite.') + '</b> The mistake was ' + esc(err.w) + ' — it should be ' + esc(cur.tk[err.i].t) + '.</p><p>' + esc(err.why) + '</p>');
        } else show('<p><b>' + (ok ? 'Correct!' : 'Not quite.') + '</b> This sentence has no mistake.</p>');
      };
      sent.onclick = function (e) {
        var el = e.target.closest && e.target.closest('.tk');
        if (!el || done) return;
        finish(!!err && +el.getAttribute('data-i') === err.i, el);
      };
      var no = mk('button', '', 'No mistake');
      no.addEventListener('click', function () { finish(!err); });
      opts.appendChild(no);
    }
  }

  function savePrefs() {
    try {
      localStorage.setItem('jp-grammar-v1', JSON.stringify({
        mode: mode, size: $('size').value, furi: $('furi').getAttribute('aria-pressed'), hint: $('hint').getAttribute('aria-pressed'),
        theme: document.documentElement.getAttribute('data-theme') || ''
      }));
    } catch (e) {}
  }
  function applyPrefs() {
    document.body.classList.toggle('nofuri', $('furi').getAttribute('aria-pressed') !== 'true');
    document.documentElement.style.setProperty('--size', $('size').value + 'px');
  }
  try {
    var d = JSON.parse(localStorage.getItem('jp-grammar-v1') || 'null');
    if (d) {
      if (d.mode) { mode = d.mode; $('mode').value = d.mode; }
      if (d.size) $('size').value = d.size;
      if (d.furi) $('furi').setAttribute('aria-pressed', d.furi);
      if (d.hint) $('hint').setAttribute('aria-pressed', d.hint);
      if (d.theme) document.documentElement.setAttribute('data-theme', d.theme);
    }
  } catch (e) {}

  $('mode').addEventListener('change', function () { mode = this.value; savePrefs(); next(); });
  $('next').addEventListener('click', next);
  ['furi', 'hint'].forEach(function (id) {
    $(id).addEventListener('click', function () {
      this.setAttribute('aria-pressed', this.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
      applyPrefs(); savePrefs();
      if (id === 'hint' && !done && cur) $('en').hidden = this.getAttribute('aria-pressed') !== 'true';
    });
  });
  $('size').addEventListener('input', function () { applyPrefs(); savePrefs(); });
  $('theme').addEventListener('click', function () {
    var r = document.documentElement;
    r.setAttribute('data-theme', getComputedStyle(r).colorScheme === 'dark' ? 'light' : 'dark'); savePrefs();
  });
  document.addEventListener('keydown', function (e) {
    if (e.target.tagName === 'SELECT' || e.target.tagName === 'INPUT') return;
    if (/^[1-4]$/.test(e.key) && !done && $('opts').children[+e.key - 1] && mode !== 'all' && mode !== 'error') $('opts').children[+e.key - 1].click();
    else if (e.key === 'Enter' && done && e.target === document.body) { e.preventDefault(); next(); }
  });

  if (window.self !== window.top) document.documentElement.classList.add('emb');
  applyPrefs(); next();
})();
</script>
</body>
</html>
